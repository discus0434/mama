# Required
# SSID broadcast by mama's access point
MAMA_SSID=mama
# WPA2 passphrase for the mama SSID (8-63 chars)
MAMA_PASSPHRASE=changeme123
# Basic auth password for the gatekeeper UI
MAMA_AUTH_PASSWORD=changeme
# OpenAI API key used for exception reviews
MAMA_OPENAI_API_KEY=sk-...

# Optional (defaults shown)
# Basic auth username for the gatekeeper UI
MAMA_AUTH_USERNAME=mama
# OpenAI model name
MAMA_OPENAI_MODEL=gpt-5.2
# Reasoning effort: none | low | medium | high
MAMA_REASONING_EFFORT=medium
# Gatekeeper bind host
MAMA_GATEKEEPER_HOST=0.0.0.0
# Gatekeeper port
MAMA_GATEKEEPER_PORT=8080
# Timezone used for scheduling
MAMA_TIMEZONE=Asia/Tokyo
# Daily reward start time (HH:MM)
MAMA_REWARD_START=21:00
# Enable or disable the daily reward window
MAMA_REWARD_ENABLED=true
# Daily exception request limit
MAMA_DAILY_LIMIT=10
# Cooldown minutes between exception approvals
MAMA_COOLDOWN_MINUTES=5
# Minimum minutes for a granted exception
MAMA_MIN_MINUTES=5
# Maximum minutes for a granted exception
MAMA_MAX_MINUTES=30

# Network (defaults shown)
# Wi-Fi country code (regulatory domain)
MAMA_COUNTRY_CODE=JP
# Interface for mama AP
MAMA_WLAN_INTERFACE=wlan0
# Upstream/WAN interface
MAMA_WAN_INTERFACE=eth0
# Wi-Fi channel for the AP
MAMA_WIFI_CHANNEL=6
# Wi-Fi mode: g (2.4GHz) or a (5GHz)
MAMA_WIFI_MODE=g
# LAN IP address for mama
MAMA_LAN_ADDRESS=192.168.50.1
# LAN netmask
MAMA_LAN_NETMASK=255.255.255.0
# DHCP range start
MAMA_DHCP_START=192.168.50.50
# DHCP range end
MAMA_DHCP_END=192.168.50.150
# DHCP lease duration
MAMA_DHCP_LEASE=12h
# dnsmasq config path
MAMA_DNSMASQ_CONFIG=/etc/dnsmasq.d/mama.conf
# hostapd config path
MAMA_HOSTAPD_CONFIG=/etc/hostapd/hostapd.conf
# nftables config path
MAMA_NFTABLES_CONFIG=/etc/nftables.conf
# sysctl config path
MAMA_SYSCTL_CONFIG=/etc/sysctl.d/99-mama.conf
# Blocklist directory containing x.txt/youtube.txt/tiktok.txt
MAMA_BLOCKLIST_DIR=/opt/mama/data/blocklists

# Paths (defaults shown)
# Gatekeeper request log path
MAMA_LOG_PATH=data/logs/requests.jsonl
# Gatekeeper state path
MAMA_STATE_PATH=data/state.json
